# Choose `auto` to use whichever credential is present. If both are set, the
# first provider in HALYK_LLM_PRIORITY wins.
HALYK_LLM_PROVIDER=auto
HALYK_LLM_PRIORITY=openai,anthropic

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=8192

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_OUTPUT_TOKENS=32768

# Shared request limits
HALYK_LLM_TIMEOUT_SECONDS=600
HALYK_LLM_MAX_OUTPUT_TOKENS=8192
